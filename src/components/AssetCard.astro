---
// One distribution or supporting file: facts, access routes, the template
// picker, file indexes, and worked examples. Data shaping lives in lib/assets.
import CopyButton from "@/components/CopyButton.astro";
import SnippetTabs from "@/components/SnippetTabs.astro";
import TemplatePicker from "@/components/TemplatePicker.astro";
import { anchor, opensInline, shapeAsset } from "@/lib/assets";
import {
  type Asset,
  type CatalogRecord,
  formatBytes,
  formatLabel,
  heldStructures,
  humanize,
  recordSlug,
} from "@/lib/catalog";
import { fetchScript, scriptLanguage } from "@/lib/snippets";

interface Props {
  record: CatalogRecord;
  asset: Asset;
  restricted: boolean;
}

const { record: d, asset, restricted } = Astro.props;
const {
  example,
  bestFor,
  extent,
  primary,
  index,
  indexes,
  openIndex,
  others,
  picker,
  download,
} = await shapeAsset(d, asset, restricted);
// The layouts this file holds; named only when there are several to tell
// apart. Long variable lists fold past six.
const layouts = heldStructures(d, asset).map((s) => ({
  ...s,
  named: asset.structures.length > 1,
  shown: s.variables.slice(0, 6).map((v) => v.name),
  more: Math.max(0, s.variables.length - 6),
}));
// An author's example script previews in place; notebooks stay downloads
const lang = asset.roles.includes("example")
  ? scriptLanguage(asset.media_type)
  : undefined;
const script = lang && primary && (await fetchScript(primary.url));
---

<div class="card asset" id={anchor("file", asset.name)}>
  <div class="card-head">
    <span class="mono asset-name">{asset.name}</span>
    {asset.roles.map((r) => <span class="label">{r}</span>)}
    {asset.file_size !== undefined && <span class="mono caption">{formatBytes(asset.file_size)}</span>}
  </div>
  {asset.description && <p class="asset-desc">{asset.description}</p>}
  {asset.media_type && (
    <p class="asset-fact">
      <b>Format:</b> {formatLabel(asset.media_type)}
      {bestFor && (
        <span class="best-for"> — best for {bestFor}</span>
      )}
    </p>
  )}
  {d.data.includes(asset) && layouts.map((s) => (
    <div class="layout">
      {s.named && <p class="layout-name mono caption">{s.name}</p>}
      {s.shown.length > 0 && (
        <p class="asset-fact">
          <b>Variables:</b> <span class="mono">{s.shown.join(", ")}</span>
          {s.more > 0 && <span class="caption"> +{s.more} more</span>}
        </p>
      )}
      {s.dimensions.length > 0 && (
        <p class="asset-fact">
          <b>Dimensions:</b>{" "}
          <span class="mono">{s.dimensions.map((x) => x.name).join(" × ")}</span>
        </p>
      )}
      <p class="asset-fact">
        <a href="#schema">Data dictionary →</a>
      </p>
    </div>
  ))}
  {extent && (
    <p class="asset-fact">
      <b>Coverage:</b> <span class="mono">{extent}</span>
    </p>
  )}
  {asset.checksum && (
    <p class="asset-fact">
      <b>Checksum:</b>{" "}
      <span class="mono" title={asset.checksum}>
        {asset.checksum.replace(/^((?:\w+:)?.{12}).+/, "$1…")}
      </span>{" "}
      <CopyButton copy={asset.checksum} label="Copy checksum" />
    </p>
  )}
  {picker && (
      <TemplatePicker picker={picker} restricted={restricted} slug={recordSlug(d)} />
    )}
  {index && (
    <div class="access-panel">
      <p class="card-head">
        <span class="tech-title">File indexes</span>
      </p>
      {/* One row per index; a row with a snippet expands to
          show it, one open at a time (details sharing a name) */}
      <div class="index-list">
        {indexes.map((ix) => {
          const row = (
            <>
              <span class="index-format">{ix.label}</span>
              {/* A sliced index names a pattern, not a file: its picker builds the URL */}
              {ix.picker ? (
                <span class="mono caption index-file" title={ix.name}>{ix.name}</span>
              ) : (
                <a class="mono caption index-file" href={ix.url} rel="noreferrer" title={ix.url}>
                  {ix.name}
                </a>
              )}
              {ix.picker ? (
                <span class="tpl-count">
                  {ix.picker.count.toLocaleString("en")} files
                </span>
              ) : (
                <CopyButton copy={ix.url} label={`Copy ${ix.label} URL`} />
              )}
              {ix.picker || ix.isDir || restricted ? (
                <span />
              ) : (
                <a class="btn btn-ghost dl" download href={ix.url}>
                  Download
                </a>
              )}
            </>
          );
          return ix.snippet || ix.picker ? (
            <details
              class="index-row"
              name={`index-${asset.name}`}
              open={ix === openIndex}
            >
              <summary class="index-head">{row}</summary>
              <div class="index-body">
                {ix.preview && (
                  <div class="inventory-preview">
                    <table class="data-table">
                      <thead>
                        <tr>
                          {ix.preview.header.map((h) => <th>{h}</th>)}
                        </tr>
                      </thead>
                      <tbody>
                        {ix.preview.rows.map((row) => (
                          <tr>
                            {row.map((cell, i) =>
                              ix.preview?.header[i] === "href" ? (
                                <td>
                                  <a class="mono" href={cell} rel="noreferrer" title={cell}>
                                    {cell.split("/").pop()}
                                  </a>
                                </td>
                              ) : (
                                <td class="mono">{cell}</td>
                              ),
                            )}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                    <p class="caption">
                      First {ix.preview.rows.length} files of the list
                    </p>
                  </div>
                )}
                {ix.picker && (
                  <TemplatePicker picker={ix.picker} restricted={restricted} slug={recordSlug(d)} />
                )}
                {ix.snippet && <SnippetTabs code={ix.snippet} />}
              </div>
            </details>
          ) : (
            <div class="index-row">
              <div class="index-head">{row}</div>
            </div>
          );
        })}
      </div>
    </div>
  )}
  {!asset.href_template && !index && primary && (
    <div class="access-panel">
      <p class="card-head">
        <span class="tech-title">Access the data</span>
        <CopyButton copy={primary.url} label="Copy URL" />
        {/* The browser shows or saves by the response type; the label just
            says which. A download attribute would be ignored cross-origin */}
        {download && (
          <a class="btn btn-ghost dl" href={download} rel="noreferrer">
            {opensInline(asset.media_type) ? "Open" : "Download"}
          </a>
        )}
      </p>
      <p class="asset-fact">
        {/* A single file links; a Zarr root or prefix is an address, not a page */}
        {download ? (
          <a class="mono url" href={download} rel="noreferrer">{download}</a>
        ) : (
          <span class="mono url">{primary.url}</span>
        )}
      </p>
    </div>
  )}
  {script && lang && (
    <details class="alt-access">
      <summary class="caption">View example</summary>
      <SnippetTabs code={{ [lang.id]: script }} />
    </details>
  )}
  {others.length > 0 && (
    <details class="alt-access">
      <summary class="caption">Other access methods</summary>
      {asset.href_template && (
        <p class="asset-fact">
          <b>File pattern:</b>{" "}
          <span class="mono">{asset.href_template}</span>
        </p>
      )}
      {others.map((loc) => (
        <div class="endpoint">
          <span class="caption">{loc.label}:</span>
          <span class="mono url">{loc.url}</span>
          <CopyButton copy={loc.url} label="Copy URL" />
        </div>
      ))}
    </details>
  )}
  {example && (
    <div class="asset-examples">
      <p class="tech-title">Usage examples</p>
      <SnippetTabs code={example} />
    </div>
  )}
</div>

<style>
.asset:target {
  border-color: var(--terra-500);
}

/* The card's border is the only box line — inside, whitespace separates.
   Visual weight: name → download → selectors → URL → technical facts */
.asset p,
.alt-access,
.asset-examples {
  margin-top: var(--space-2);
}

/* Name + description read as one unit; the breathing room sits below them */
.asset-desc {
  margin-top: var(--space-1);
  margin-bottom: var(--space-3);
  font-size: var(--font-size-5);
  color: var(--text-soft);
}

.asset-name {
  font-size: var(--font-size-6);
  font-weight: 700;
  color: var(--cdh-blue-950);
}

/* One download style everywhere, height-matched to the copy buttons */
.dl {
  height: 26px;
  padding: 0 var(--space-3);
  font-size: var(--font-size-3);
}

/* Per-asset facts — light labels, darker values; mono only on literals */
.asset-fact {
  font-size: var(--font-size-4);
  color: var(--text);
}

.asset-fact b {
  font-weight: 500;
  color: var(--text-mute);
}

.asset-fact .mono {
  font-size: var(--font-size-3);
}

/* Index rows: caret | format | file name | copy | download. A fixed format
   column keeps rows aligned, since each row is its own grid */
.index-list {
  margin-top: var(--space-3);
}

.index-row + .index-row {
  border-top: 1px solid var(--border);
}

.index-head {
  display: grid;
  grid-template-columns: 1rem 10rem minmax(0, 1fr) auto auto;
  gap: var(--space-3);
  align-items: center;
  padding: var(--space-2) var(--space-1);
  list-style: none;
}

.index-head::-webkit-details-marker {
  display: none;
}

/* Caret only on rows that expand; plain rows keep the column empty */
.index-head::before {
  font-size: var(--font-size-5);
  color: var(--text-soft);
  content: "";
}

summary.index-head {
  cursor: pointer;
  border-radius: var(--radius-sm);
}

summary.index-head::before {
  content: "▸";
}

details[open] > summary.index-head::before {
  content: "▾";
}

summary.index-head:hover {
  background: color-mix(in srgb, var(--text) 4%, transparent);
}

.index-format {
  font-size: var(--font-size-4);
  font-weight: 500;
}

/* The sliced index's file count, quieter than the pattern beside it */
.tpl-count {
  font-weight: 400;
  color: var(--text-mute);
}

.index-file {
  overflow-wrap: anywhere;
}

.index-body {
  padding: var(--space-1) 0 var(--space-3);
}

/* The inventory's first rows, before its snippet */
.inventory-preview {
  margin-bottom: var(--space-3);
  overflow-x: auto;
}

.inventory-preview .data-table {
  font-size: var(--font-size-3);
}

.best-for {
  font-family: var(--sans);
  color: var(--text-mute);
}

/* Interactive units — a tinted inset panel groups the spotlighted access
   URL (and, in TemplatePicker, the file picker) against the card's surface */
.access-panel {
  padding: var(--space-4);
  margin-top: var(--space-3);
  background: var(--bg);
  border-radius: var(--radius-md);
}

/* The panel's padding is its top edge; drop the card's paragraph margin */
.access-panel > :first-child {
  margin-top: 0;
}

/* Icon and text buttons share a row: centre them, not their baselines */
.access-panel .card-head {
  align-items: center;
}

.alt-access summary {
  cursor: pointer;
  user-select: none;
}

.alt-access summary:hover {
  color: var(--cdh-blue-700);
}

.alt-access :global(.snippet) {
  margin-top: var(--space-2);
}

.endpoint {
  display: grid;
  grid-template-columns: minmax(56px, max-content) 1fr auto;
  gap: var(--space-2);
  align-items: center;
  padding: var(--space-1) 0;
  margin-top: var(--space-2);
}

/* A named layout opens its own small block of facts */
.asset .layout-name {
  margin-top: var(--space-3);
}
</style>
