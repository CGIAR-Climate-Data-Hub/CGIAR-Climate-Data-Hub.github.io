---
// A select (or date field) per href_template token, with copy and download
// on the file they pick. Used for an asset's template and a sliced index's.
import CopyButton from "@/components/CopyButton.astro";
import { humanize } from "@/lib/catalog";

interface Props {
  picker: {
    fields: {
      name: string;
      values: string[];
      labels?: Record<string, string>;
      date?: { min: string; max: string; step: number };
    }[];
    file: string;
    combos?: string;
    template?: string;
    root: string;
    url: string;
    count: number;
    csv: string;
  };
  slug: string;
  restricted: boolean;
}

const { picker, slug, restricted } = Astro.props;
---

<div
  class="tpl-picker"
  data-combos={picker.combos}
  data-file={picker.file}
  data-root={picker.root}
  data-template={picker.template}
>
  {picker.count > 0 && (
          <p class="card-head">
            <span class="tech-title">
              List of files{" "}
              <span class="tpl-count">
                {picker.count.toLocaleString("en")} files
              </span>
            </span>
            <a
              class="btn btn-ghost dl"
              download={picker.csv}
              href={`/catalog/${slug}/${picker.csv}`}
            >
              Download CSV
            </a>
          </p>
        )}
  <p class="card-head file-head">
    <span class="tech-title">Individual file</span>
  </p>
  {/* The selectors, with the actions on the file they pick */}
  <div class="tpl-row">
    <div class="tpl-fields">
      {picker.fields.map((f) =>
            // One value is no choice: keep it for the URL, show no control
            f.values.length === 1 ? (
              <input data-tpl-dim={f.name} type="hidden" value={f.values[0]} />
            ) : (
            // biome-ignore lint/a11y/noLabelWithoutControl: the control is inside, behind a ternary
            <label class="tpl-field">
              <span class="caption">{humanize(f.name)}</span>
              {f.date ? (
                <input
                  data-tpl-dim={f.name}
                  max={f.date.max}
                  min={f.date.min}
                  required
                  step={f.date.step}
                  type="date"
                  value={f.date.min}
                />
              ) : (
                <select data-tpl-dim={f.name}>
                  {f.values.map((v) => (
                    <option value={v}>{f.labels?.[v] ?? v}</option>
                  ))}
                </select>
              )}
            </label>
            ),
          )}
    </div>
    <CopyButton copy={picker.url} label="Copy selected file URL" />
    {!restricted && (
            <a
              class="btn btn-ghost dl"
              data-tpl-download
              download
              href={picker.url}
            >
              Download
            </a>
          )}
  </div>
  <p class="mono url selected-url" data-tpl-url>{picker.url}</p>
</div>

<script>
import { fillTemplate } from "@/lib/template";

// Template pickers: the selects and date fields fill the asset's
// href_template; the built URL feeds the row's copy button and download link
for (const picker of document.querySelectorAll<HTMLElement>(".tpl-picker")) {
  const fields = [
    ...picker.querySelectorAll<HTMLInputElement | HTMLSelectElement>(
      "[data-tpl-dim]",
    ),
  ];
  const copyBtn = picker.querySelector<HTMLButtonElement>("button[data-copy]");
  const dl = picker.querySelector<HTMLAnchorElement>("[data-tpl-download]");
  const urlEl = picker.querySelector<HTMLElement>("[data-tpl-url]");
  // Structures with different values for the same token: a change moves
  // the other fields onto a structure holding the new value, if they must
  const combos: Record<string, string[]>[] = JSON.parse(
    picker.dataset.combos ?? "[]",
  );
  const dim = (f: HTMLElement) => f.dataset.tplDim ?? "";
  const snap = (changed: HTMLInputElement | HTMLSelectElement) => {
    const holds = combos.filter((c) => c[dim(changed)].includes(changed.value));
    const fit =
      holds.find((c) => fields.every((f) => c[dim(f)].includes(f.value)))
      ?? holds[0];
    for (const f of fields)
      if (!fit[dim(f)].includes(f.value)) f.value = fit[dim(f)][0];
  };
  const update = () => {
    // A cleared or out-of-range date names no file: park the actions
    const valid = fields.every((f) => f.value && f.validity.valid);
    if (copyBtn) copyBtn.disabled = !valid;
    // An anchor without href is no link, so the download stops too
    if (dl && !valid) dl.removeAttribute("href");
    if (!valid) return;
    const file = fillTemplate(
      picker.dataset.template ?? "",
      Object.fromEntries(fields.map((f) => [f.dataset.tplDim, f.value])),
    );
    const url = (picker.dataset.root ?? "") + file;
    if (urlEl) urlEl.textContent = url;
    if (copyBtn) copyBtn.dataset.copy = url;
    if (dl) dl.href = url;
    // The usage example bakes in the previous selection's filename — swap it
    // wherever it appears in the card's examples so they stay live
    const prev = picker.dataset.file;
    // An index picker's snippet sits beside it; an asset's under the card
    const examples =
      picker.closest(".index-body")
      ?? picker.closest(".asset")?.querySelector(".asset-examples");
    if (examples && prev && prev !== file) {
      const walker = document.createTreeWalker(examples, NodeFilter.SHOW_TEXT);
      while (walker.nextNode()) {
        const node = walker.currentNode;
        if (node.nodeValue?.includes(prev))
          node.nodeValue = node.nodeValue.replaceAll(prev, file);
      }
    }
    picker.dataset.file = file;
  };
  picker.addEventListener("change", (e) => {
    if (combos.length) snap(e.target as HTMLSelectElement);
    update();
  });
  update();
}
</script>

<style>
/* A tinted inset panel groups the picker against the card's surface */
.tpl-picker {
  padding: var(--space-4);
  margin-top: var(--space-3);
  background: var(--bg);
  border-radius: var(--radius-md);
}

.tpl-picker > :first-child {
  margin-top: 0;
}

/* One download style everywhere, height-matched to the copy buttons */
.dl {
  height: 26px;
  padding: 0 var(--space-3);
  font-size: var(--font-size-3);
}

.tpl-fields {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3) var(--space-4);
  margin-top: var(--space-3);
}

/* Label above its control */
.tpl-field {
  display: inline-flex;
  flex-direction: column;
  gap: var(--space-1);
}

.tpl-field select,
.tpl-field input {
  padding: 2px 6px;
  font-size: var(--font-size-3);
  color: var(--text);
  background: var(--surface);
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-sm);
}

/* Quieter than the asset name — it labels a control group, not content */
/* Panel headings: the card's sub-sections, one step under the asset name */
.tpl-count {
  font-weight: 400;
  color: var(--text-mute);
}

.selected-url {
  margin-top: var(--space-2);
}

/* Selectors left, the picked file's copy and Download right */
.tpl-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  align-items: flex-end;
  margin-top: var(--space-3);
}

.tpl-row .tpl-fields {
  margin-top: 0;
  margin-right: auto;
}

/* The individual-file section, divided from the file list above */
.file-head {
  padding-top: var(--space-4);
  margin-top: var(--space-4);
  border-top: 1px solid var(--border);
}
</style>
