---
// Code block with a language toggle (languages from lib/snippets). The chosen
// language syncs across every instance on the page; a block missing that
// language keeps showing the one it has. One language renders no toggle.
import { Code } from "astro:components";
import type { BundledLanguage } from "shiki";
import { codeHeader, shikiConfig } from "@/lib/code-block";
import { LANGUAGES, type Snippets } from "@/lib/snippets";

interface Props {
  code: Snippets;
  // Language id shown before the visitor picks one; defaults to the first given
  first?: string;
}

const { code, first } = Astro.props;
const tabs = LANGUAGES.flatMap((l) =>
  code[l.id] ? [{ ...l, code: code[l.id] }] : [],
).sort((a, b) => Number(b.id === first) - Number(a.id === first));
---

<div class="snippet">
  {tabs.length > 1 && (
    <div class="seg">
      {tabs.map((t, i) => (
        <button aria-pressed={i === 0 ? "true" : "false"} data-lang={t.id} type="button">
          {t.label}
        </button>
      ))}
    </div>
  )}
  {tabs.map((t, i) => (
    <div data-snippet={t.id} hidden={i > 0}>
      <Code
        code={t.code}
        lang={t.id as BundledLanguage}
        theme={shikiConfig.theme}
        transformers={[codeHeader(t.label)]}
      />
    </div>
  ))}
</div>

<script>
const buttons = document.querySelectorAll<HTMLButtonElement>("[data-lang]");

function setLang(lang: string) {
  for (const snip of document.querySelectorAll<HTMLElement>(".snippet")) {
    const panels = [...snip.querySelectorAll<HTMLElement>("[data-snippet]")];
    if (panels.some((p) => p.dataset.snippet === lang))
      for (const p of panels) p.hidden = p.dataset.snippet !== lang;
    // Each block marks the language it shows, which may not be the one picked
    const shown = panels.find((p) => !p.hidden)?.dataset.snippet;
    for (const b of snip.querySelectorAll<HTMLButtonElement>("[data-lang]"))
      b.setAttribute("aria-pressed", String(b.dataset.lang === shown));
  }
}

for (const btn of buttons) {
  btn.addEventListener("click", () => {
    const lang = btn.dataset.lang ?? "python";
    localStorage.setItem("snippet-lang", lang);
    setLang(lang);
  });
}

// Returning visitors land on their language (same pattern as catalog-layout)
const saved = localStorage.getItem("snippet-lang");
if (saved) setLang(saved);
</script>

<style>
.snippet {
  margin-top: var(--space-1);
}

.seg {
  margin-bottom: 10px;
}
</style>
