---
import { getCollection } from "astro:content";
import { satteri } from "@astrojs/markdown-satteri";
import AssetCard from "@/components/AssetCard.astro";
import BboxMap from "@/components/BboxMap.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Citation from "@/components/Citation.astro";
import CopyButton from "@/components/CopyButton.astro";
import JsonLd from "@/components/JsonLd.astro";
import SnippetTabs from "@/components/SnippetTabs.astro";
import Layout from "@/layouts/Layout.astro";
import { anchor, urlParts } from "@/lib/assets";
import {
  citable,
  datasetJsonLd,
  geoLabel,
  gridSpacings,
  HORIZONTAL,
  heldStructures,
  humanize,
  licenseUrl,
  licensor,
  normalizeBboxes,
  recordSlug,
  stacCollectionUrl,
  stepLabel,
  temporalText,
  versionChain,
  versionedSlug,
} from "@/lib/catalog";
import { authorName } from "@/lib/citation";
import { shikiConfig } from "@/lib/code-block";
import { allTutorials } from "@/lib/collections";
import { blobUrl, editUrl, githubUrl } from "@/lib/github";
import { quickstart } from "@/lib/snippets";
import { commodity } from "@/lib/vocab";
import { CATALOG_REPO, SITE_NAME } from "@/site.config";

export async function getStaticPaths() {
  const entries = await getCollection("catalog");
  // Record descriptions may carry markdown; render like any other content
  const markdown = await satteri().createRenderer({ shikiConfig });
  // A current release's <id>_<version> redirects to <id> until superseded
  const redirects = entries
    .filter((e) => !e.data.deprecated)
    .map((e) => ({
      params: { id: versionedSlug(e.data) },
      props: { redirect: `/catalog/${e.data.id}/` },
    }));
  const pages = await Promise.all(
    entries.map(async (entry) => ({
      params: { id: recordSlug(entry.data) },
      props: {
        entry,
        descriptionHtml: (await markdown.render(entry.data.description)).code,
      },
    })),
  );
  return [...pages, ...redirects];
}

if ("redirect" in Astro.props) return Astro.redirect(Astro.props.redirect, 301);
const { entry, descriptionHtml } = Astro.props;
const d = entry.data;

const catalog = await getCollection("catalog");
// Newest-first version chain; the head is the current release
const chain = versionChain(d.id, catalog);
const current = d.deprecated ? chain[0] : undefined;

// Provenance cross-links: derived_from ids render as internal links, and
// records derived from this one list in the rail. No drawn DAG.
// A pinned version links that release's permanent URL
const hubSource = (src: { id?: string; version?: string }) => {
  const rec = catalog.find((e) => !e.data.deprecated && e.data.id === src.id);
  const slug = src.version ? `${src.id}_${src.version}` : src.id;
  return rec && { href: `/catalog/${slug}/`, title: rec.data.title };
};
const derivatives = catalog
  .filter(
    (e) =>
      !e.data.deprecated
      && e.data.processing.some((s) =>
        s.derived_from.some((src) => src.id === d.id),
      ),
  )
  .map((e) => ({ href: `/catalog/${e.data.id}/`, title: e.data.title }));

// Parent and child representations, linked by the child's `parent` id
const parent = catalog.find(
  (e) => !e.data.deprecated && e.data.id === d.parent,
);
const children = catalog.filter(
  (e) => !e.data.deprecated && e.data.parent === d.id,
);

const bboxes = normalizeBboxes(d.spatial?.bbox);
const coverage = d.spatial?.geography.map(geoLabel).join(", ");
const spacings = gridSpacings(d);
const resolution = spacings.join(" · ");
const temporal = temporalText(
  d.temporal,
  d.structures
    .flatMap((s) => s.dimensions)
    .map((dim) => (dim.type === "temporal" ? dim.step : undefined))
    .find((step) => typeof step === "string"),
);
const source = licensor(d);
// Contact order: maintainers (accountable for the record), then licensors, then the rest
const roleRank = (c: (typeof d.contact)[number]) =>
  c.roles.includes("maintainer") ? 2 : c.roles.includes("licensor") ? 1 : 0;
const contacts = [...d.contact]
  .sort((a, b) => roleRank(b) - roleRank(a))
  .map((c) => ({
    ...c,
    otherRoles: c.roles.filter((r) => r !== "maintainer" && r !== "licensor"),
  }));
const recordUrl = new URL(`/catalog/${recordSlug(d)}/`, Astro.site).href;
const restricted = Boolean(d.access && d.access !== "public");
const crsHref =
  d.spatial?.crs && /^EPSG:\d+$/.test(d.spatial.crs)
    ? `https://epsg.io/${d.spatial.crs.split(":")[1]}`
    : undefined;
const hasSchema = d.structures.length > 0;
// One data dictionary per structure; with several, each is headed by its
// name and the files that hold it
const multiStructure = d.structures.length > 1;
// A dimension's domain as legend entries: coded values with labels, or bare ones
const legendItems = (
  dim: (typeof d.structures)[number]["dimensions"][number],
) =>
  dim.categories.length > 0
    ? dim.categories
    : dim.values.map((value) => ({
        value,
        label: undefined,
        description: undefined,
      }));

const structures = d.structures.map((s) => ({
  ...s,
  files: d.data
    .filter((a) => heldStructures(d, a).includes(s))
    .map((a) => a.name),
  // The variables table grows a "No data" column only when one has a value
  varNodata: s.variables.some((v) => v.nodata !== undefined),
}));
// A foreign key's target: a Hub record by id (its title), else its URL
// shortened to the last path segment, with the host as a quiet hint
const fkTarget = (resource: string) => {
  if (!resource.includes(":")) {
    const rec = catalog.find(
      (e) => !e.data.deprecated && e.data.id === resource,
    );
    return rec
      ? { href: `/catalog/${rec.data.id}/`, title: rec.data.title, host: "" }
      : { href: undefined, title: resource, host: "" };
  }
  const u = new URL(resource);
  const name = u.pathname.split("/").filter(Boolean).pop() ?? u.host;
  return { href: resource, title: name, host: u.host };
};
// An asset's layout: each structure it holds, its variables and dimensions
const hasTemplated = d.data.some((a) => a.href_template);
const stacUrl = stacCollectionUrl(d.id);
// Record metadata lives in the catalog repo, so source + issue links point
// there. Flat strings on purpose: Biome's Astro frontmatter parser trips on
// template literals nested two deep.
const sourceUrl = blobUrl(CATALOG_REPO, entry.filePath);
const reportBody = [
  `Record page: ${recordUrl}`,
  sourceUrl ? `Source: ${sourceUrl}` : "",
  "",
  "**What's wrong?**",
  "",
].join("\n");
const reportParams = new URLSearchParams({
  title: `[record] ${d.id}: `,
  body: reportBody,
});
const reportUrl = `${githubUrl(CATALOG_REPO)}/issues/new?${reportParams}`;
const cite = citable(d);
const licenseHref = licenseUrl(d.license);

// Build-time cross-links: stories and tutorials citing this dataset id
const seenIn = (
  await getCollection("useCases", (uc) => uc.data.datasets.includes(d.id))
).map((uc) => ({
  href: `/in-use/${uc.id}/`,
  title: uc.data.title,
  partner: uc.data.partner,
}));
const tutorialLinks = (await allTutorials())
  .filter((t) => t.data.datasets.includes(d.id))
  .map((t) => ({
    href: `/tutorials/${t.id}/`,
    title: t.data.title,
    meta: `${t.data.audience} · ${t.data.time}`,
  }));

// Example code, from the template files in src/snippets (see lib/snippets).
// The quick start stacks one short block per format, unless the record ships
// its own example script for that language; each asset card in Access & use
// carries its own worked example (spatial clip / point sample).
const quick = await quickstart(d);

// The standard separates the distributions from supporting material
const assetGroups = [
  { title: "Data", items: d.data },
  { title: "Additional assets", items: d.additional_assets },
].filter((g) => g.items.length > 0);

const SECTIONS = [
  ["overview", "Overview"],
  // Access & use first after Overview — it's the tab most visits are for
  d.data.length > 0 && ["access", "Access & use"],
  hasSchema && ["schema", "Data dictionary"],
  (d.climate || d.spatial || d.temporal) && ["technical", "Technical metadata"],
  d.processing.length > 0 && ["provenance", "Provenance"],
  (cite || d.contact.length > 0) && [
    "citation",
    cite && d.contact.length > 0
      ? "Citation & contacts"
      : cite
        ? "Citation"
        : "Contacts",
  ],
].filter(Boolean) as [string, string][];

const jsonLd = datasetJsonLd(
  d,
  recordUrl,
  new URL("/catalog/", Astro.site).href,
);
---

<Layout
  description={d.description.slice(0, 160)}
  title={`${d.title} — ${SITE_NAME}`}
>
  <JsonLd data={jsonLd} slot="head" />

  <section class="header">
    <div class="container">
      <Breadcrumbs
        items={[{ label: "Hub", href: "/" }, { label: "Catalog", href: "/catalog/" }, { label: d.title }]}
      />
      {d.deprecated && (
        <div class="deprecated-note">
          This is an older release ({d.version}).
          {current && (
            <>
              {" "}
              <a href={`/catalog/${current.data.id}/`}>
                Go to the current version ({current.data.version}) →
              </a>
            </>
          )}
        </div>
      )}
      <div class="header-grid">
        <div>
          <h1>{d.title}</h1>
          {source && <p class="source">{source}</p>}
          {d.series && (
            <p class="series-line">
              Part of:{" "}
              <a href={`/catalog/?series=${encodeURIComponent(d.series.name)}`}>
                {d.series.name}
              </a>
            </p>
          )}

          <div class="version-row">
            <span class="label">Version</span>
            {chain.length > 1 ? (
              <details class="drop-menu version-menu">
                <summary class="btn btn-ghost">
                  {d.version}
                  {!current && <span class="latest">LATEST</span>}
                  <svg
                    aria-hidden="true"
                    fill="none"
                    height="10"
                    stroke="currentColor"
                    stroke-width="2.4"
                    viewBox="0 0 24 24"
                    width="10"
                  >
                    <path d="M6 9l6 6 6-6" />
                  </svg>
                </summary>
                <div class="menu-list">
                  {chain.map((v, i) => (
                    <a
                      aria-current={v.data.version === d.version ? "page" : undefined}
                      href={`/catalog/${recordSlug(v.data)}/`}
                    >
                      {v.data.version}
                      {i === 0 && <span class="latest">LATEST</span>}
                    </a>
                  ))}
                </div>
              </details>
            ) : (
              <span class="version-single">{d.version}</span>
            )}
            {restricted && (
              <span class="mono access-flag">
                {humanize(d.access ?? "")} access
              </span>
            )}
          </div>

          <div class="mono meta-row">
            <span class="fact">
              <span class="fact-label">license</span>
              {licenseHref ? (
                <a href={licenseHref} rel="noreferrer">{d.license}</a>
              ) : (
                d.license
              )}
            </span>
            {d.doi && (
              <span class="fact">
                <span class="fact-label">doi</span>
                <a href={`https://doi.org/${d.doi}`}>{d.doi}</a>
              </span>
            )}
            <span class="fact">
              <span class="fact-label">updated</span>
              {d.updated}
            </span>
          </div>

          <div class="ctas">
            <a class="btn btn-primary" href="#access">
              {restricted ? "Request access" : "Access the data"}
            </a>
            <details class="drop-menu meta-menu">
              <summary class="btn btn-ghost">
                Metadata
                <svg
                  aria-hidden="true"
                  fill="none"
                  height="10"
                  stroke="currentColor"
                  stroke-width="2.4"
                  viewBox="0 0 24 24"
                  width="10"
                >
                  <path d="M6 9l6 6 6-6" />
                </svg>
              </summary>
              <div class="menu-list">
                <a href={`/catalog/${recordSlug(d)}.json`}>Raw record (JSON)</a>
                {hasTemplated && (
                  <a href={stacUrl} rel="noreferrer">
                    STAC Collection ↗
                  </a>
                )}
                {entry.filePath && (
                  <a
                    class="menu-split"
                    href={editUrl(CATALOG_REPO, entry.filePath)}
                    >Suggest an edit ↗</a
                  >
                )}
                <a
                  href={reportUrl}
                  rel="noreferrer"
                  class:list={[{ "menu-split": !entry.filePath }]}
                >
                  Report a problem ↗
                </a>
              </div>
            </details>
          </div>
        </div>

        <div>
          <BboxMap bboxes={bboxes} label={coverage} />
        </div>
      </div>
    </div>
  </section>

  <nav aria-label="Sections" class="section-nav">
    <div class="container">
      {SECTIONS.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
    </div>
  </nav>

  <div class="container body">
    <article>
      <section id="overview">
        <header>
          <h2>Overview</h2>
          <div class="prose" set:html={descriptionHtml} />
        </header>

        {d.keywords.length > 0 && (
            <div class="keywords">
              {d.keywords.map((k) =>
                typeof k === "string" ? (
                  <a class="mono keyword" href={`/catalog/?q=${encodeURIComponent(k)}`}>
                    #{k}
                  </a>
                ) : (
                  <a class="mono keyword ontology" href={k.uri ?? k.scheme} rel="noreferrer" title={`${k.scheme ?? "ontology"} concept`}>
                    {k.term} ↗
                  </a>
                ),
              )}
            </div>
          )}

        {d.note && (
            <div class="note">
              <h2 class="note-title">Important note</h2>
              <p>{d.note}</p>
            </div>
          )}

        {Object.keys(quick.code).length > 0 && (
            <section>
              <h2>Quick start</h2>
              {/* Open on the authors' own language when they wrote one */}
              <SnippetTabs code={quick.code} first={quick.authored[0]?.id} />
              {quick.authored.length > 0 && (
                <p class="section-sub">
                  Provided by the dataset authors:{" "}
                  {quick.authored.map((l, i) => (
                    <>
                      {i > 0 && ", "}
                      <a href={l.url} rel="noreferrer">{l.label} example</a>
                    </>
                  ))}
                </p>
              )}
              <p class="section-sub">
                <a href="#access">Full access details and endpoints</a>
              </p>
            </section>
          )}

        {d.cdh && d.cdh.usage.intended_uses.length > 0 && (
            <section>
              <h2>Intended uses</h2>
              <ul class="uses">
                {d.cdh.usage.intended_uses.map((u) => (
                  <li>{u}</li>
                ))}
              </ul>
            </section>
          )}

        {d.cdh && d.cdh.usage.not_recommended_for.length > 0 && (
            <section>
              <h2>Not recommended for</h2>
              <div class="warn-cards">
                {d.cdh.usage.not_recommended_for.map((n) => (
                  <div class="card warn-card">
                    <b>{n.use}</b>
                    {n.reason && (
                      <p>
                        <b>Why:</b> {n.reason}
                      </p>
                    )}
                    {n.use_instead && (
                      <p class="instead">
                        <b>Use instead:</b> {n.use_instead}
                      </p>
                    )}
                  </div>
                ))}
              </div>
            </section>
          )}

        {d.commodities.length > 0 && (
            <section>
              <h2>Commodities</h2>
              <div class="chips">
                {d.commodities.map((id) => {
                  const c = commodity(id);
                  return c?.uri ? (
                    <a class="chip" href={c.uri} rel="noreferrer" title={`AGROVOC ${c.code}`}>
                      {c.label} ↗
                    </a>
                  ) : (
                    <span class="chip">{c?.label ?? humanize(id)}</span>
                  );
                })}
              </div>
            </section>
          )}
      </section>

      {d.data.length > 0 && (
          <section id="access">
            <header>
              <h2>Access &amp; use</h2>
              <p class="section-sub">
                Cloud-optimised distributions — read just the window you need directly from object
                storage.
              </p>
              {hasTemplated && (
                <p class="section-sub">
                  Machine-readable file index:{" "}
                  <a href={stacUrl} rel="noreferrer">STAC Collection</a>
                </p>
              )}
            </header>
            {d.access_note && (
              <div class="note">
                <h3 class="note-title">Access conditions</h3>
                <p>{d.access_note}</p>
              </div>
            )}

            {assetGroups.map((group) => (
              <section>
                <h3 class="tech-title">{group.title}</h3>
                <div class="assets">
                  {group.items.map((asset) => (
                    <AssetCard asset={asset} record={d} restricted={restricted} />
                  ))}
                </div>
              </section>
            ))}
          </section>
        )}

      {hasSchema && (
          <section id="schema">
            <header>
              <h2>Data dictionary</h2>
              <p class="section-sub">
                {multiStructure
                  ? "One dictionary per file layout: its dimensions, variables, and keys."
                  : "Dimensions, variables, and keys of the data."}
              </p>
            </header>
            {structures.map((s) => (
              <section class="var-group" id={anchor("structure", s.name)}>
                {multiStructure && <h3 class="tech-title mono">{s.name}</h3>}
                {s.files.length > 0 && (
                  <p class="structure-files">
                    Files:{" "}
                    {s.files.map((name, i) => (
                      <>
                        {i > 0 && ", "}
                        <a class="mono" href={`#${anchor("file", name)}`}>{name}</a>
                      </>
                    ))}
                  </p>
                )}
                {s.geometry_column && (
                  <p class="structure-files">
                    Geometry column: <span class="mono">{s.geometry_column}</span>
                  </p>
                )}
                {s.variables.length > 0 && (
                  <>
                <h3 class="tech-title">Variables</h3>
                <div class="card table-wrap">
                  <table class="data-table">
                    <thead>
                      <tr>
                        <th>Variable</th>
                        <th>Type</th>
                        <th>Unit</th>
                        {s.varNodata && <th>No data</th>}
                        <th>Description</th>
                      </tr>
                    </thead>
                    <tbody>
                      {s.variables.map((v) => (
                          <tr>
                            <td class="mono var-name">{v.name}</td>
                            <td class="mono">{v.data_type ?? "—"}</td>
                            <td class="mono">{v.unit ?? "—"}</td>
                            {s.varNodata && <td class="mono">{v.nodata ?? "—"}</td>}
                            <td>
                              {v.description ?? "—"}
                              {v.note && <div class="var-note">{v.note}</div>}
                              {v.categories.length > 0 && (
                                <dl class="class-list">
                                  {v.categories.map((cv) => (
                                    <>
                                      <dt class="mono">{cv.value}</dt>
                                      <dd>
                                        {cv.label}
                                        {cv.description && (
                                          <span class="class-desc">
                                            {" "}
                                            — {cv.description}
                                          </span>
                                        )}
                                      </dd>
                                    </>
                                  ))}
                                </dl>
                              )}
                            </td>
                          </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                  </>
                )}
                {s.dimensions.length > 0 && (
                  <>
                <h3 class="tech-title">Dimensions</h3>
                <div class="dim-cards">
                  {s.dimensions.map((dim) => (
                    <div class="card dim-card">
                      <div class="head">
                        <span class="mono dim-name">{dim.name}</span>
                        {dim.type && <span class="label">{dim.type}</span>}
                      </div>
                      {dim.description && <p>{dim.description}</p>}
                      {dim.data_type && (
                        <p>
                          <b>Data type:</b> <span class="mono">{dim.data_type}</span>
                        </p>
                      )}
                      {dim.unit && <p><b>Unit:</b> <span class="mono">{dim.unit}</span></p>}
                      {dim.reference_system && (
                        <p>
                          <b>Coded against:</b>{" "}
                          {/^https?:/.test(dim.reference_system) ? (
                            <a class="mono" href={dim.reference_system} rel="noreferrer">
                              {dim.reference_system}
                            </a>
                          ) : (
                            dim.reference_system
                          )}
                        </p>
                      )}
                      {HORIZONTAL.includes(dim.type ?? "") && (
                        <p>
                          {typeof dim.step === "number" && dim.unit ? (
                            <>
                              <b>Grid spacing:</b>{" "}
                              <span class="mono">
                                {dim.step} {dim.unit}
                              </span>
                            </>
                          ) : (
                            "Coordinate column"
                          )}
                        </p>
                      )}
                      {dim.extent && (
                        <p class="mono">
                          {dim.extent[0]} – {dim.extent[1]}
                          {typeof dim.step === "string" && `, ${stepLabel(dim.step)}`}
                        </p>
                      )}
                      {/* The axis's domain as a legend: code, then its label when coded.
                          Past twelve entries the list folds behind the toggle (CSS below) */}
                      {legendItems(dim).length > 0 && (
                        <ul class="legend">
                          {legendItems(dim).map((c) => (
                            <li title={c.description}>
                              <code>{c.value}</code> {c.label}
                            </li>
                          ))}
                        </ul>
                      )}
                      <details class="legend-more">
                        <summary>
                          <span class="when-closed">Show all {legendItems(dim).length} values</span>
                          <span class="when-open">Show fewer</span>
                        </summary>
                      </details>
                    </div>
                  ))}
                </div>
                  </>
                )}
                {s.foreign_keys.length > 0 && (
                  <>
                <h3 class="tech-title">Foreign keys</h3>
                <div class="dim-cards">
                  {s.foreign_keys.map((fk) => {
                    const target = fkTarget(fk.reference.resource);
                    return (
                      <div class="card dim-card">
                        <p class="fk-head">
                          Joins to{" "}
                          {target.href ? (
                            <a href={target.href} rel="noreferrer">{target.title}</a>
                          ) : (
                            <b>{target.title}</b>
                          )}
                          {target.host && <span class="fk-host"> · {target.host}</span>}
                          {fk.reference.asset && (
                            <span class="fk-host">
                              {" "}
                              · file <span class="mono">{fk.reference.asset}</span>
                            </span>
                          )}
                        </p>
                        {/* Columns pair up by position */}
                        <table class="data-table">
                          <thead>
                            <tr>
                              <th>This table</th>
                              <th />
                              <th>{target.title}</th>
                            </tr>
                          </thead>
                          <tbody>
                            {fk.fields.map((field, i) => (
                              <tr>
                                <td class="mono">{field}</td>
                                <td class="fk-arrow">→</td>
                                <td class="mono">{fk.reference.fields[i]}</td>
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      </div>
                    );
                  })}
                </div>
                  </>
                )}
              </section>
            ))}
          </section>
        )}

      {(d.climate || d.spatial || d.temporal) && (
          <section id="technical">
            <header>
              <h2>Technical metadata</h2>
              <p class="section-sub">
                The full spatial, temporal, and modeling detail behind the
                summaries elsewhere on this page.
              </p>
            </header>
            {d.spatial && (
              <section>
                <h3 class="tech-title">Spatial</h3>
                <dl class="kv">
                  {d.spatial.crs && (
                    <>
