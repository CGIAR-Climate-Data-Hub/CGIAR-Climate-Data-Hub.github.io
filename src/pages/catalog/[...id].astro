                      )}
                      {c.orcid && (
                        <a href={c.orcid} rel="noreferrer">
                          ORCID ↗
                        </a>
                      )}
                      {c.ror && (
                        <a href={c.ror} rel="noreferrer">
                          ROR ↗
                        </a>
