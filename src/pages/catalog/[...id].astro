---
import { getCollection } from "astro:content";
import { satteri } from "@astrojs/markdown-satteri";
import AssetCard from "@/components/AssetCard.astro";
import BboxMap from "@/components/BboxMap.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Citation from "@/components/Citation.astro";
import CopyButton from "@/components/CopyButton.astro";
import DataDictionary from "@/components/DataDictionary.astro";
import JsonLd from "@/components/JsonLd.astro";
import SnippetTabs from "@/components/SnippetTabs.astro";
import Layout from "@/layouts/Layout.astro";
import {
  citable,
  currentReleases,
  datasetJsonLd,
  geoLabel,
  gridSpacings,
  humanize,
  lastSegment,
  licenseUrl,
  licensor,
  normalizeBboxes,
  recordSlug,
  stacCollectionUrl,
  temporalText,
  versionChain,
  versionedSlug,
  year,
} from "@/lib/catalog";
import { authorName } from "@/lib/citation";
import { shikiConfig } from "@/lib/code-block";
import { allTutorials } from "@/lib/collections";
import { blobUrl, editUrl, githubUrl } from "@/lib/github";
import { quickstart } from "@/lib/snippets";
import { commodity } from "@/lib/vocab";
import { CATALOG_REPO, SITE_NAME } from "@/site.config";

export async function getStaticPaths() {
  const entries = await getCollection("catalog");
  // Record descriptions may carry markdown; render like any other content
  const markdown = await satteri().createRenderer({ shikiConfig });
  // A current release's <id>_<version> redirects to <id> until superseded
  const redirects = entries
    .filter((e) => !e.data.deprecated)
    .map((e) => ({
      params: { id: versionedSlug(e.data) },
      props: { redirect: `/catalog/${e.data.id}/` },
    }));
  const pages = await Promise.all(
    entries.map(async (entry) => ({
      params: { id: recordSlug(entry.data) },
      props: {
        entry,
        descriptionHtml: (await markdown.render(entry.data.description)).code,
      },
    })),
  );
  return [...pages, ...redirects];
}

if ("redirect" in Astro.props) return Astro.redirect(Astro.props.redirect, 301);
const { entry, descriptionHtml } = Astro.props;
const d = entry.data;

const catalog = await getCollection("catalog");
// Newest-first version chain; the head is the current release
const chain = versionChain(d.id, catalog);
const current = d.deprecated ? chain[0] : undefined;

// Provenance cross-links: derived_from ids render as internal links, and
// records derived from this one list in the rail. No drawn DAG.
// A pinned version links that release's permanent URL
const live = currentReleases(catalog);
const liveById = new Map(live.map((e) => [e.data.id, e]));
const hubSource = (src: { id?: string; version?: string }) => {
  const rec = src.id && liveById.get(src.id);
  const slug = src.version ? `${src.id}_${src.version}` : src.id;
  return rec && { href: `/catalog/${slug}/`, title: rec.data.title };
};
const derivatives = live
  .filter((e) =>
    e.data.processing.some((s) =>
      s.derived_from.some((src) => src.id === d.id),
    ),
  )
  .map((e) => ({ href: `/catalog/${e.data.id}/`, title: e.data.title }));

// Parent and child representations, linked by the child's `parent` id
const parent = d.parent && liveById.get(d.parent);
const children = live.filter((e) => e.data.parent === d.id);

const bboxes = normalizeBboxes(d.spatial?.bbox);
const coverage = d.spatial?.geography.map(geoLabel).join(", ");
const spacings = gridSpacings(d);
const resolution = spacings.join(" · ");
const temporal = temporalText(
  d.temporal,
  d.structures
    .flatMap((s) => s.dimensions)
    .map((dim) => (dim.type === "temporal" ? dim.step : undefined))
    .find((step) => typeof step === "string"),
);
const source = licensor(d);
// Contact order: maintainers (accountable for the record), then licensors, then the rest
const roleRank = (c: (typeof d.contact)[number]) =>
  c.roles.includes("maintainer") ? 2 : c.roles.includes("licensor") ? 1 : 0;
const contacts = [...d.contact]
  .sort((a, b) => roleRank(b) - roleRank(a))
  .map((c) => ({
    ...c,
    otherRoles: c.roles.filter((r) => r !== "maintainer" && r !== "licensor"),
  }));
const recordUrl = new URL(`/catalog/${recordSlug(d)}/`, Astro.site).href;
const restricted = Boolean(d.access && d.access !== "public");
const crsHref =
  d.spatial?.crs && /^EPSG:\d+$/.test(d.spatial.crs)
    ? `https://epsg.io/${d.spatial.crs.split(":")[1]}`
    : undefined;
const hasSchema = d.structures.length > 0;
// The STAC collection indexes templated files, so only those records link it
const stacUrl = d.data.some((a) => a.href_template)
  ? stacCollectionUrl(d.id)
  : undefined;
// Record metadata lives in the catalog repo, so source + issue links point
// there. Flat strings on purpose: Biome's Astro frontmatter parser trips on
// template literals nested two deep.
const sourceUrl = blobUrl(CATALOG_REPO, entry.filePath);
const reportBody = [
  `Record page: ${recordUrl}`,
  sourceUrl ? `Source: ${sourceUrl}` : "",
  "",
  "**What's wrong?**",
  "",
].join("\n");
const reportParams = new URLSearchParams({
  title: `[record] ${d.id}: `,
  body: reportBody,
});
const reportUrl = `${githubUrl(CATALOG_REPO)}/issues/new?${reportParams}`;
const cite = citable(d);
const licenseHref = licenseUrl(d.license);

// Build-time cross-links: stories and tutorials citing this dataset id
const seenIn = (
  await getCollection("useCases", (uc) => uc.data.datasets.includes(d.id))
).map((uc) => ({
  href: `/in-use/${uc.id}/`,
  title: uc.data.title,
  partner: uc.data.partner,
}));
const tutorialLinks = (await allTutorials())
  .filter((t) => t.data.datasets.includes(d.id))
  .map((t) => ({
    href: `/tutorials/${t.id}/`,
    title: t.data.title,
    meta: `${t.data.audience} · ${t.data.time}`,
  }));

// Example code, from the template files in src/snippets (see lib/snippets).
// The quick start stacks one short block per format, unless the record ships
// its own example script for that language; each asset card in Access & use
// carries its own worked example (spatial clip / point sample).
const quick = await quickstart(d);

// The standard separates the distributions from supporting material
const assetGroups = [
  { title: "Data", items: d.data },
  { title: "Additional assets", items: d.additional_assets },
].filter((g) => g.items.length > 0);

// Technical facts as label/value rows; empty values drop out, empty blocks too
const joined = (parts: (string | undefined)[], sep: string) =>
  parts.filter(Boolean).join(sep);
const techBlocks = [
  d.spatial && {
    title: "Spatial",
    facts: [
      { label: "CRS", value: d.spatial.crs, href: crsHref },
      {
        label: "Extent (W S E N)",
        value: bboxes?.map((b) => `[${b.join(", ")}]`).join("  "),
        mono: true,
      },
      { label: "Coverage", value: coverage },
      ...spacings.map((value) => ({ label: "Grid spacing", value })),
    ],
  },
  d.temporal && {
    title: "Temporal",
    facts:
      "date" in d.temporal
        ? [{ label: "Reference date", value: d.temporal.date, mono: true }]
        : [
            { label: "Start", value: d.temporal.start_date, mono: true },
            {
              label: "End",
              value: d.temporal.end_date ?? "open (present)",
              mono: true,
            },
            {
              label: "Updates",
              value:
                d.temporal.update_frequency
                && humanize(d.temporal.update_frequency),
            },
          ],
  },
  d.climate && {
    title: "Climate methods",
    facts: [
      { label: "MIP era", value: d.climate.mip_era },
      { label: "Models", value: d.climate.models.join(", "), mono: true },
      { label: "Scenarios", value: d.climate.scenarios.join(", "), mono: true },
      {
        label: "Baseline",
        value:
          d.climate.baseline
          && joined(
            [
              year(d.climate.baseline.start_date),
              d.climate.baseline.end_date && year(d.climate.baseline.end_date),
            ],
            " – ",
          ),
      },
      {
        label: "Bias adjustment",
        value:
          d.climate.bias_adjustment
          && joined(
            [
              d.climate.bias_adjustment.method,
              d.climate.bias_adjustment.reference_dataset,
            ],
            " · ",
          ),
      },
      {
        label: "Downscaling",
        value:
          d.climate.downscaling
          && joined(
            [d.climate.downscaling.method, d.climate.downscaling.resolution],
            " · ",
          ),
      },
    ],
  },
]
  .filter((block) => !!block)
  .map((block) => ({
    ...block,
    facts: block.facts.flatMap((f) =>
      f.value ? [{ ...f, value: f.value }] : [],
    ),
  }))
  .filter((block) => block.facts.length > 0);

const SECTIONS = [
  ["overview", "Overview"],
  // Access & use first after Overview — it's the tab most visits are for
  d.data.length > 0 && ["access", "Access & use"],
  hasSchema && ["schema", "Data dictionary"],
  techBlocks.length > 0 && ["technical", "Technical metadata"],
  d.processing.length > 0 && ["provenance", "Provenance"],
  (cite || d.attribution || d.contact.length > 0) && [
    "citation",
    "Citation & contacts",
  ],
].filter(Boolean) as [string, string][];

const jsonLd = datasetJsonLd(
  d,
  recordUrl,
  new URL("/catalog/", Astro.site).href,
);
---

<Layout
  description={d.description.slice(0, 160)}
  title={`${d.title} — ${SITE_NAME}`}
>
  <JsonLd data={jsonLd} slot="head" />

  <section class="header">
    <div class="container">
      <Breadcrumbs
        items={[{ label: "Hub", href: "/" }, { label: "Catalog", href: "/catalog/" }, { label: d.title }]}
      />
      {d.deprecated && (
        <div class="deprecated-note">
          This is an older release ({d.version}).
          {current && (
            <>
              {" "}
              <a href={`/catalog/${current.data.id}/`}>
                Go to the current version ({current.data.version}) →
              </a>
            </>
          )}
        </div>
      )}
      <div class="header-grid">
        <div>
          <h1>{d.title}</h1>
          {source && <p class="source">{source}</p>}
          {d.series && (
            <p class="series-line">
              Part of:{" "}
              <a href={`/catalog/?series=${encodeURIComponent(d.series.name)}`}>
                {d.series.name}
              </a>
            </p>
          )}

          <div class="version-row">
            <span class="label">Version</span>
            {chain.length > 1 ? (
              <>
              <button
                class="btn btn-ghost drop-menu version-menu"
                popovertarget="version-menu"
                type="button"
              >
                  {d.version}
                  {!current && <span class="latest">LATEST</span>}
                  <svg
                    aria-hidden="true"
                    fill="none"
                    height="10"
                    stroke="currentColor"
                    stroke-width="2.4"
                    viewBox="0 0 24 24"
                    width="10"
                  >
                    <path d="M6 9l6 6 6-6" />
                  </svg>
              </button>
                <div class="menu-list" id="version-menu" popover>
                  {chain.map((v, i) => (
                    <a
                      aria-current={v.data.version === d.version ? "page" : undefined}
                      href={`/catalog/${recordSlug(v.data)}/`}
                    >
                      {v.data.version}
                      {i === 0 && <span class="latest">LATEST</span>}
                    </a>
                  ))}
                </div>
              </>
            ) : (
              <span class="version-single">{d.version}</span>
            )}
            {restricted && (
              <span class="mono access-flag">
                {humanize(d.access ?? "")} access
              </span>
            )}
          </div>

          <div class="mono meta-row">
            <span class="fact">
              <span class="fact-label">license</span>
              {licenseHref ? (
                <a href={licenseHref} rel="noreferrer">{d.license}</a>
              ) : (
                d.license
              )}
            </span>
            {d.doi && (
              <span class="fact">
                <span class="fact-label">doi</span>
                <a href={`https://doi.org/${d.doi}`}>{d.doi}</a>
              </span>
            )}
            <span class="fact">
              <span class="fact-label">created</span>
              {d.created}
            </span>
            <span class="fact">
              <span class="fact-label">updated</span>
              {d.updated}
            </span>
          </div>

          <div class="ctas">
            <a class="btn btn-primary" href="#access">
              {restricted ? "Request access" : "Access the data"}
            </a>
            <button
              class="btn btn-ghost drop-menu meta-menu"
              popovertarget="meta-menu"
              type="button"
            >
              Metadata
              <svg
                aria-hidden="true"
                fill="none"
                height="10"
                stroke="currentColor"
                stroke-width="2.4"
                viewBox="0 0 24 24"
                width="10"
              >
                <path d="M6 9l6 6 6-6" />
              </svg>
            </button>
            <div class="menu-list" id="meta-menu" popover>
              <a href={`/catalog/${recordSlug(d)}.json`}>Raw record (JSON)</a>
              {stacUrl && (
                  <a href={stacUrl} rel="noreferrer">
                    STAC Collection ↗
                  </a>
                )}
              {entry.filePath && (
                  <a
                    class="menu-split"
                    href={editUrl(CATALOG_REPO, entry.filePath)}
                    >Suggest an edit ↗</a
                  >
                )}
              <a
                href={reportUrl}
                rel="noreferrer"
                class:list={[{ "menu-split": !entry.filePath }]}
              >
                Report a problem ↗
              </a>
            </div>
          </div>
        </div>

        <div>
          <BboxMap bboxes={bboxes} label={coverage} />
        </div>
      </div>
    </div>
  </section>

  <nav aria-label="Sections" class="section-nav">
    <div class="container">
      {SECTIONS.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
    </div>
  </nav>

  <div class="container body">
    <article>
      <section id="overview">
        <header>
          <h2>Overview</h2>
          <div class="prose" set:html={descriptionHtml} />
        </header>

        {d.keywords.length > 0 && (
            <div class="keywords">
              {d.keywords.map((k) =>
                typeof k === "string" ? (
                  <a class="mono keyword" href={`/catalog/?q=${encodeURIComponent(k)}`}>
                    #{k}
                  </a>
                ) : (
                  <a class="mono keyword ontology" href={k.uri ?? k.scheme} rel="noreferrer" title={`${k.scheme ?? "ontology"} concept`}>
                    {k.term} ↗
                  </a>
                ),
              )}
            </div>
          )}

        {d.note && (
            <div class="note">
              <h2 class="note-title">Important note</h2>
              <p>{d.note}</p>
            </div>
          )}

        {Object.keys(quick.code).length > 0 && (
            <section>
              <h2>Quick start</h2>
              {/* Open on the authors' own language when they wrote one */}
              <SnippetTabs code={quick.code} first={quick.authored[0]?.id} />
              {quick.authored.length > 0 && (
                <p class="section-sub">
                  Provided by the dataset authors:{" "}
                  {quick.authored.map((l, i) => (
                    <>
                      {i > 0 && ", "}
                      <a href={l.url} rel="noreferrer">{l.label} example</a>
                    </>
                  ))}
                </p>
              )}
              <p class="section-sub">
                <a href="#access">Full access details and endpoints</a>
              </p>
            </section>
          )}

        {d.cdh && d.cdh.usage.intended_uses.length > 0 && (
            <section>
              <h2>Intended uses</h2>
              <ul class="uses">
                {d.cdh.usage.intended_uses.map((u) => (
                  <li>{u}</li>
                ))}
              </ul>
            </section>
          )}

        {d.cdh && d.cdh.usage.not_recommended_for.length > 0 && (
            <section>
              <h2>Not recommended for</h2>
              <div class="warn-cards">
                {d.cdh.usage.not_recommended_for.map((n) => (
                  <div class="card warn-card">
                    <b>{n.use}</b>
                    {n.reason && (
                      <p>
                        <b>Why:</b> {n.reason}
                      </p>
                    )}
                    {n.use_instead && (
                      <p class="instead">
                        <b>Use instead:</b> {n.use_instead}
                      </p>
                    )}
                  </div>
                ))}
              </div>
            </section>
          )}

        {d.commodities.length > 0 && (
            <section>
              <h2>Commodities</h2>
              <div class="chips">
                {d.commodities.map((id) => {
                  const c = commodity(id);
                  return c?.uri ? (
                    <a class="chip" href={c.uri} rel="noreferrer" title={`AGROVOC ${c.code}`}>
                      {c.label} ↗
                    </a>
                  ) : (
                    <span class="chip">{c?.label ?? humanize(id)}</span>
                  );
                })}
              </div>
            </section>
          )}
      </section>

      {d.data.length > 0 && (
          <section id="access">
            <header>
              <h2>Access &amp; use</h2>
              <p class="section-sub">
                Files, endpoints, and worked examples for each distribution.
              </p>
              {stacUrl && (
                <p class="section-sub">
                  Machine-readable file index:{" "}
                  <a href={stacUrl} rel="noreferrer">STAC Collection</a>
                </p>
              )}
            </header>
            {d.access_note && (
              <div class="note">
                <h3 class="note-title">Access conditions</h3>
                <p>{d.access_note}</p>
              </div>
            )}

            {assetGroups.map((group) => (
              <section>
                <h3 class="tech-title">{group.title}</h3>
                <div class="assets">
                  {group.items.map((asset) => (
                    <AssetCard asset={asset} record={d} restricted={restricted} />
                  ))}
                </div>
              </section>
            ))}
          </section>
        )}

      {hasSchema && (
          <section id="schema">
            <header>
              <h2>Data dictionary</h2>
              <p class="section-sub">
                What each file holds. A layout describes how the data is stored in a file: its
                variables, the dimensions they vary over, and any keys.
              </p>
            </header>
            <DataDictionary liveById={liveById} record={d} />
          </section>
        )}
      {techBlocks.length > 0 && (
          <section id="technical">
            <header>
              <h2>Technical metadata</h2>
              <p class="section-sub">
                The full spatial, temporal, and modeling detail behind the
                summaries elsewhere on this page.
              </p>
            </header>
            {techBlocks.map((block) => (
              <section>
                <h3 class="tech-title">{block.title}</h3>
                <dl class="kv">
                  {block.facts.map((f) => (
                    <>
                      <dt>{f.label}</dt>
                      <dd class:list={{ mono: f.mono }}>
                        {f.href ? <a href={f.href} rel="noreferrer">{f.value}</a> : f.value}
                      </dd>
                    </>
                  ))}
                </dl>
              </section>
            ))}
          </section>
        )}

      {d.processing.length > 0 && (
          <section id="provenance">
            <header>
              <h2>Provenance</h2>
              <p class="section-sub">Ordered processing steps, from source to publication.</p>
            </header>
            <ol class="lineage">
              {d.processing.map((step) => (
                <li>
                  <div class="card step">
                    <div class="card-head">
                      <span class="mono step-id">{step.id}</span>
                      {step.date && <span class="label">{step.date.slice(0, 10)}</span>}
                    </div>
                    {step.description && <p>{step.description}</p>}
                    {step.derived_from.length > 0 && (
                      <p class="step-meta">
                        Derived from:{" "}
                        {step.derived_from.map((src, i) => {
                          const hub = hubSource(src);
                          return (
                            <>
                              {i > 0 && ", "}
                              {hub ? (
                                <a href={hub.href}>
                                  {src.title ?? hub.title}
                                  {src.version && ` (${src.version})`}
                                </a>
                              ) : (
                                <a href={src.url} rel="noreferrer">
                                  {src.title ?? src.url ?? src.id}
                                </a>
                              )}
                            </>
                          );
                        })}
                      </p>
                    )}
                    {step.code && (
                      <p class="step-meta">
                        Code:{" "}
                        <a class="mono" href={step.code.url} rel="noreferrer" title={step.code.url}>
                          {lastSegment(step.code.url)} ↗
                        </a>
                        {step.code.version && (
                          <>
                            {" "}
                            <span class="label">@ {step.code.version}</span>
                          </>
                        )}
                      </p>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </section>
        )}

      {(cite || d.attribution || d.contact.length > 0) && (
          <section id="citation">
            {cite && (
              <Citation
                cite={cite}
                note="Please cite the dataset and any associated peer-reviewed publications."
                viaUrl={new URL(`/catalog/${versionedSlug(d)}/`, Astro.site).href}
              >
                {d.related_publications.length > 0 && (
                  <section class="related-pubs">
                    <h3 class="tech-title">Related publications</h3>
                    <ul>
                      {d.related_publications.map((pub) => (
                        <li>
                          {pub.citation
                            && `${[
                              pub.citation.authors.map(authorName).join(", "),
                              `(${pub.citation.date}).`,
                              pub.citation.title && `${pub.citation.title}.`,
                              pub.citation.publisher && `${pub.citation.publisher}.`,
                            ]
                              .filter(Boolean)
                              .join(" ")} `}
                          {pub.doi && <a href={`https://doi.org/${pub.doi}`}>doi:{pub.doi}</a>}
                        </li>
                      ))}
                    </ul>
                  </section>
                )}
              </Citation>
            )}
            {d.attribution && (
              <section class="attribution">
                <h3 class="tech-title">Attribution</h3>
                <p class="section-sub">
                  Reproduce this credit line wherever you reuse the data.
                </p>
                <blockquote>
                  {d.attribution}{" "}
                  <CopyButton copy={d.attribution} label="Copy attribution" />
                </blockquote>
              </section>
            )}
            {d.contact.length > 0 && (
            <section>
            <h2>Contacts</h2>
            <p class="section-sub">
              Who produced this dataset, and who to reach about it.
            </p>
            <div class="contact-cards">
              {contacts.map((c) => (
                <div class="card contact-card">
                  <div class="card-head">
                    <b>{c.name ?? c.organization}</b>
                    <span class="badges">
                      {c.roles.includes("maintainer") && (
                        <span class="role-badge maintainer-badge">Maintainer</span>
                      )}
                      {c.roles.includes("licensor") && (
                        <span class="role-badge licensor-badge">Licensor</span>
                      )}
                    </span>
                  </div>
                  {c.name && c.organization && (
                    <div class="contact-org">{c.organization}</div>
                  )}
                  {c.otherRoles.length > 0 && (
                    <div class="chips">
                      {c.otherRoles.map((r) => (
                        <span class="chip">{humanize(r)}</span>
                      ))}
                    </div>
                  )}
                  {(c.email || c.url || c.orcid || c.ror) && (
                    <div class="contact-links">
                      {c.email && <a href={`mailto:${c.email}`}>{c.email}</a>}
                      {c.url && (
                        <a href={c.url} rel="noreferrer">
                          {c.url.replace(/^https?:\/\//, "")} ↗
                        </a>
                      )}
                      {c.orcid && (
                        <a href={c.orcid} rel="noreferrer">
                          ORCID ↗
                        </a>
                      )}
                      {c.ror && (
                        <a href={c.ror} rel="noreferrer">
                          ROR ↗
                        </a>
                      )}
                    </div>
                  )}
                </div>
              ))}
            </div>
            </section>
            )}
          </section>
        )}
    </article>

    <aside>
      <div class="card rail-box">
        <h2 class="label">Quick facts</h2>
        <dl class="kv">
          {coverage && (
            <>
              <dt>Coverage</dt>
              <dd>{coverage}</dd>
            </>
          )}
          {resolution && (
            <>
              <dt>Resolution</dt>
              <dd>{resolution}</dd>
            </>
          )}
          {d.spatial?.crs && (
            <>
              <dt>CRS</dt>
              <dd>
                {crsHref ? (
                  <a href={crsHref} rel="noreferrer">{d.spatial.crs}</a>
                ) : (
                  d.spatial.crs
                )}
              </dd>
            </>
          )}
          {temporal && (
            <>
              <dt>Temporal</dt>
              <dd>
                {temporal.main}
                {temporal.sub && <div class="caption fact-sub">{temporal.sub}</div>}
              </dd>
            </>
          )}
          {d.cdh && d.cdh.domain.length > 0 && (
            <>
              <dt>Domain</dt>
              <dd>{d.cdh.domain.map(humanize).join(", ")}</dd>
            </>
          )}
        </dl>
      </div>

      {tutorialLinks.length > 0 && (
          <div class="card rail-box">
            <h2 class="label">Tutorials</h2>
            {tutorialLinks.map((t) => (
              <a class="rail-link" href={t.href}>
                <b>{t.title}</b>
                <span class="caption">{t.meta}</span>
              </a>
            ))}
          </div>
        )}

      {parent && (
          <div class="card rail-box">
            <h2 class="label">Parent record</h2>
            <a class="rail-link" href={`/catalog/${parent.data.id}/`}>
              <b>{parent.data.title}</b>
            </a>
          </div>
        )}

      {children.length > 0 && (
          <div class="card rail-box">
            <h2 class="label">Child records</h2>
            {children.map((c) => (
              <a class="rail-link" href={`/catalog/${c.data.id}/`}>
                <b>{c.data.title}</b>
              </a>
            ))}
          </div>
        )}

      {derivatives.length > 0 && (
          <div class="card rail-box">
            <h2 class="label">Derived datasets</h2>
            {derivatives.map((der) => (
              <a class="rail-link" href={der.href}>
                <b>{der.title}</b>
              </a>
            ))}
          </div>
        )}

      {seenIn.length > 0 && (
          <div class="card rail-box">
            <h2 class="label">Seen in</h2>
            {seenIn.map((uc) => (
              <a class="rail-link" href={uc.href}>
                <b>{uc.title}</b>
                <span class="caption">{uc.partner}</span>
              </a>
            ))}
          </div>
        )}

      {d.additional_links.length > 0 && (
          <div class="card rail-box">
            <h2 class="label">Related links</h2>
            {d.additional_links.map((link) => (
              <a class="rail-link ext" href={link.url} rel="noreferrer">
                {link.title ?? link.url} ↗
              </a>
            ))}
          </div>
        )}

      {d.funding.length > 0 && (
          <div class="card rail-box">
            <h2 class="label">Funding</h2>
            {d.funding.map((f) =>
              f.url ? (
                <a class="rail-link ext" href={f.url} rel="noreferrer">
                  {f.name} ↗
                </a>
              ) : (
                <div class="rail-text">{f.name}</div>
              ),
            )}
          </div>
        )}
    </aside>

    <div class="footer-row">
      <a class="back" href="/catalog/">← Back to the catalog</a>
    </div>
  </div>
</Layout>

<script>
// Hash-driven tabs: all panels stay in the DOM (crawlers see everything);
// the hash picks the visible one, so /catalog/<id>#access deep-links work.
const tabs = [
  ...document.querySelectorAll<HTMLAnchorElement>(".section-nav a"),
];
const panels = tabs
  .map((a) => document.getElementById(a.hash.slice(1)))
  .filter((el): el is HTMLElement => el !== null);

// A hash may name a panel or something inside one (#file-zarr); show its panel
function showPanel(id: string) {
  const el = id ? document.getElementById(id) : null;
  const target = panels.find((s) => el && s.contains(el))?.id ?? panels[0]?.id;
  for (const s of panels) s.hidden = s.id !== target;
  for (const a of tabs)
    a.setAttribute("aria-current", String(a.hash === `#${target}`));
}
// Don't strand the reader mid-page: reveal the new panel top if it's off-screen,
// or the linked element when the hash points inside a panel
function snapToPanel() {
  const el = document.getElementById(location.hash.slice(1));
  if (el && !panels.includes(el)) return el.scrollIntoView();
  const panel = panels.find((s) => !s.hidden);
  if (panel && panel.getBoundingClientRect().top < 130) panel.scrollIntoView();
}

if (tabs.length > 0) {
  // replaceState instead of a real navigation — skips the browser's anchor jump
  for (const a of tabs) {
    a.addEventListener("click", (e) => {
      // A modified click opens the section in a new tab or window
      if (e.ctrlKey || e.metaKey || e.shiftKey || e.button !== 0) return;
      e.preventDefault();
      history.replaceState(null, "", a.hash);
      showPanel(a.hash.slice(1));
      snapToPanel();
    });
  }
  // In-content links (Access the data / see the full schema) and back-forward
  addEventListener("hashchange", () => {
    showPanel(location.hash.slice(1));
    snapToPanel();
  });
  showPanel(location.hash.slice(1));
  if (location.hash) snapToPanel();
}
</script>

